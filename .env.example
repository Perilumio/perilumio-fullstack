NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Canonical site URL used to build email activation/redirect links (e.g. https://perilumio.ch).
# When unset, the register/resend APIs fall back to the request Origin header.
NEXT_PUBLIC_SITE_URL=https://perilumio.ch
